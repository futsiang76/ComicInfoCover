# 敏感信息配置文件模板
# 复制此文件为 secrets.py 并填入真实值
# secrets.py 已加入 .gitignore，不会被提交到 Git

# Bangumi API Token — 用于访问 NSFW 内容
# 从 https://bgm.tv 获取
BANGUMI_ACCESS_TOKEN = "your_bangumi_token_here"

# ComicVine API Key — 用于欧美漫画数据源
# 从 https://comicvine.gamespot.com/api/ 获取
COMICVINE_API_KEY = "your_comicvine_api_key_here"
